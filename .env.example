# Copy this file to .env.local for local development, or set these as
# real environment variables wherever you deploy. Nothing here is required
# to run the site — every value has an honest fallback (a working contact
# form, an open dashboard) when left unset. See README.md for details.

# --- Dashboard access -------------------------------------------------
# Required before sharing the /dashboard link or sending real traffic:
# it now shows real leads (names, emails, phone numbers). Set both to
# require HTTP Basic Auth on every /dashboard/* route (see middleware.ts).
# Left unset, the dashboard stays open to anyone with the URL.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# --- Business contact details ------------------------------------------
# Shown in the footer, and used for mailto:/tel: links, once set. Until
# then the site shows a working "Contact NOVERA" form instead of a dead
# link — never invent these values.
NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_ADDRESS=

# --- Site --------------------------------------------------------------
# Used for canonical URLs, Open Graph tags, and the sitemap. Set this to
# your real production domain once you have one.
NEXT_PUBLIC_SITE_URL=https://novera.example
